          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def runId = props.get(&apos;TESTSTART.MS&apos;) ?: System.currentTimeMillis().toString()
synchronized (props) {
    if (props.get(&apos;raceRunId&apos;) != runId) {
        props.put(&apos;raceRunId&apos;, runId)
        props.put(&apos;raceY&apos;, System.currentTimeMillis().toString())
        props.put(&apos;raceCreate201&apos;, &apos;0&apos;)
        props.put(&apos;raceCreate409&apos;, &apos;0&apos;)
        props.put(&apos;raceUpdate200&apos;, &apos;0&apos;)
        props.put(&apos;raceUpdate409&apos;, &apos;0&apos;)
        props.remove(&apos;raceCoordinatesId&apos;)
    }
}</stringProp>
