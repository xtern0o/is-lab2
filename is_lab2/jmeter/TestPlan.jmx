        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="08 Prepare Import File" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def now = System.currentTimeMillis()
def suffix = &quot;${ctx.getThreadNum()}-${now}&quot;
def importedX = 300.0 + ctx.getThreadNum() + ((now % 1000) / 10000.0)
def importedY = now
def file = new File(System.getProperty(&apos;java.io.tmpdir&apos;), &quot;is-lab2-import-${suffix}.conf&quot;)

file.setText(&quot;&quot;&quot;locations = []
coordinates = []
persons = []
movies = [
  {
    name = \&quot;jmeter Imported Movie ${suffix}\&quot;
    coordinates {
      x = ${importedX}
      y = ${importedY}
    }
    oscarsCount = 1
    budget = 200000
    totalBoxOffice = 700000
    mpaaRating = PG_13
    director {
      name = \&quot;JMeter Imported Director ${suffix}\&quot;
      eyeColor = GREEN
      hairColor = BLACK
      height = 181
      nationality = FRANCE
    }
    length = 121
    goldenPalmCount = 1
    genre = THRILLER
  }
]
&quot;&quot;&quot;, &apos;UTF-8&apos;)

vars.put(&apos;importFile&apos;, file.absolutePath)
vars.put(&apos;importSuffix&apos;, suffix)</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="09 Import File" enabled="true">
