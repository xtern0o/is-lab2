        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="C4 verify concurrent results">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">if (ctx.getThreadNum() == 0) {
    def actual = &quot;create: 201=${props.get(&apos;raceCreate201&apos;)}, 409=${props.get(&apos;raceCreate409&apos;)}; &quot; +
                 &quot;update: 200=${props.get(&apos;raceUpdate200&apos;)}, 409=${props.get(&apos;raceUpdate409&apos;)}&quot;
    if (props.get(&apos;raceCreate201&apos;) != &apos;1&apos; || props.get(&apos;raceCreate409&apos;) != &apos;1&apos; ||
        props.get(&apos;raceUpdate200&apos;) != &apos;1&apos; || props.get(&apos;raceUpdate409&apos;) != &apos;1&apos;) {
        throw new AssertionError(&apos;concurrency isolation check failed: &apos; + actual)
    }
    log.info(&apos;concurrency isolation check passed: &apos; + actual)
}</stringProp>
        </JSR223Sampler>
