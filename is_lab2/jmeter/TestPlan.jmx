          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="extract concurrent coordinatesId">
            <stringProp name="JSONPostProcessor.referenceNames">raceCoordinatesIdLocal</stringProp>
