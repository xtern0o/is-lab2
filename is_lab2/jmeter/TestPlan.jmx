            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def code = prev.getResponseCode()
synchronized (props) {
    if (code == &apos;200&apos;) {
        props.put(&apos;raceUpdate200&apos;, (((props.get(&apos;raceUpdate200&apos;) ?: &apos;0&apos;) as int) + 1).toString())
    } else if (code == &apos;409&apos;) {
        props.put(&apos;raceUpdate409&apos;, (((props.get(&apos;raceUpdate409&apos;) ?: &apos;0&apos;) as int) + 1).toString())
    }
}</stringProp>
          </JSR223PostProcessor>
